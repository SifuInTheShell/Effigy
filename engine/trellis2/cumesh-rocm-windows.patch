+        EdgeKey* d_keys = thrust::raw_pointer_cast(keys.data());
+        auto count_begin = thrust::make_counting_iterator<int>(0);
+        auto head_flags = thrust::make_transform_iterator(count_begin, HeadFlagFunctor{d_keys});
+
