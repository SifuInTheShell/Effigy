+    if (ensure_consistency) {
+        // Copy original corner data
+        corners_copy.resize(N * 8);
+        thrust::copy(thrust::hip::par.on(stream), 
+                     d_corners, d_corners + N * 8, 
+                     corners_copy.begin());
