 #include "cumesh.h"
+#include <algorithm>
 
 
 namespace cumesh {
 
 
+/**
+ * cudaMemcpy2D device to device. effigy-amd: hipMemcpy2D on Windows (ROCm 7.2.1) copies only the first ~2^20
+ * rows and leaves the rest untouched, so a 5M-face mesh came in as 1M faces and 4M zeros (and simplify ran
+ * a 12M-face loop for vertex 0). Packed rows are one linear copy; others go 65536 rows at a time.
+ */
+static void copy_rows(void* dst, size_t dpitch, const void* src, size_t spitch, size_t width, size_t height) {
+    if (dpitch == width && spitch == width) {
+        CUDA_CHECK(cudaMemcpy(dst, src, width * height, cudaMemcpyDeviceToDevice));
+        return;
+    }
+    const size_t chunk = 65536;
+    for (size_t r = 0; r < height; r += chunk) {
+        CUDA_CHECK(cudaMemcpy2D(
+            static_cast<char*>(dst) + r * dpitch, dpitch,
+            static_cast<const char*>(src) + r * spitch, spitch,
+            width, std::min(chunk, height - r),
+            cudaMemcpyDeviceToDevice
+        ));
+    }
+}
+
+
 template <typename T>
 struct TorchTypeMapping;
 
