+// table_kvs:   [capacity * 2]
+// coords:      [N * num_dims]
+// queries:     [M * num_dims]
+// out_indices: [M]
+__global__ void search_kernel(
+    const int* __restrict__ table_kvs,
+    const int* __restrict__ coords,
+    const int* __restrict__ queries,
+    int num_queries,
+    int table_capacity,
+    int num_dims,
+    int* __restrict__ out_indices
+) {
