+struct RemapTri {
+    const int* map;
+    __host__ __device__ void operator()(Tri& tri) const {
+        tri.v0 = map[tri.v0];
+        tri.v1 = map[tri.v1];
+        tri.v2 = map[tri.v2];
+    }
+};
